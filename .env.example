# ---------------------------------------------------------------------------
# SLOPX configuration. Copy to .env (gitignored) and fill in.
# NEVER commit .env. NEVER paste private keys into chat, issues or logs.
# On Replit, put these in the Secrets tab instead of a file.
# ---------------------------------------------------------------------------

# --- Network (Elysium testnet defaults; mainnet chain id is UNVERIFIED — confirm with Kinetiq docs)
CHAIN_ID=99801
CHAIN_NAME=Elysium Testnet
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
EXPLORER_URL=https://explorer-elysium-testnet.t.conduit.xyz

# --- Contract (after deployment)
CONTRACT_ADDRESS=
START_BLOCK=0                 # deployment block, so event indexing doesn't scan from genesis

# --- Keys: use DEDICATED BURNER wallets only. Fill in yourself.
DEPLOYER_PRIVATE_KEY=         # only needed for `forge script` deployment
KEEPER_PRIVATE_KEY=           # hot key that proposes results/settles; fund with a little HYPE for gas
KEEPER_ADDRESS=               # public address of the keeper key (used by the deploy script)
GUARDIAN_ADDRESS=             # ideally a multisig; can reject results, pause, void (refund only)
TREASURY_ADDRESS=             # receives fees
ROUND_DURATION=3600

# --- Keeper / data
KEEPER_ENABLED=false          # true = run keeper inside the web server process (single Replit deployment)
GECKO_NETWORK=                # GeckoTerminal network slug for Elysium once listed (check /api/v2/networks)
SAMPLE_INTERVAL_SEC=30
DISCOVERY_INTERVAL_SEC=300
MIN_LIQUIDITY_USD=5000
MIN_SELLERS_24H=5
MAX_WEIGHT=0.10
MIN_CONSTITUENTS=5

# --- Website
PORT=3000
# ISO country codes blocked from depositing. Requires a proxy that sets a country header
# (Cloudflare `cf-ipcountry`, Vercel, CloudFront, App Engine). Replit alone does not.
BLOCKED_REGIONS=US,GB,FR,SG,AU,KP,IR,SY,CU,RU,BY
